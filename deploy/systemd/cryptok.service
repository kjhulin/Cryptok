# /etc/systemd/system/cryptok.service
[Unit]
Description=Cryptok code cracker (behind nginx)
After=network.target

[Service]
User=cryptok
Group=cryptok
WorkingDirectory=/opt/cryptok
# Replace example.com with your host name.
ExecStart=/opt/cryptok/cryptok serve --host 127.0.0.1 --port 8077 --no-open \
          --public --allowed-host example.com \
          --model /opt/cryptok/cryptok.cklm --sources /opt/cryptok/corpus
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=2G
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
