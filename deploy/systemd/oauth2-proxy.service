# /etc/systemd/system/oauth2-proxy.service
[Unit]
Description=oauth2-proxy (Google sign-in for cryptok.space)
After=network.target

[Service]
User=oauth2-proxy
# OAUTH2_PROXY_CLIENT_SECRET=... and OAUTH2_PROXY_COOKIE_SECRET=..., mode 0600, root-owned.
EnvironmentFile=/etc/oauth2-proxy/secrets.env
ExecStart=/usr/local/bin/oauth2-proxy --config=/etc/oauth2-proxy/oauth2-proxy.cfg
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
